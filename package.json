{
  "name": "kdczyz-dsh-model",
"version": "1.3.0",
  "description": "DSH plugin merging WorkBuddy, Trae, and Qoder model pools into three independent providers with one unified settings page (XD Pool / Trae config / accounts / Qoder pool / credits / usage history). Manual account switching, per-account credits, and browser-login account adding.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdczyz/kdczyz-dsh-model.git"
  },
  "homepage": "https://github.com/kdczyz/kdczyz-dsh-model#readme",
  "bugs": {
    "url": "https://github.com/kdczyz/kdczyz-dsh-model/issues"
  },
  "license": "MIT",
  "author": "dhdbvcg",
  "contributors": [
    "XDTrees (dsh-workbuddy-xdpool, vendored under dsh-kdczyz-mode/vendor/xdpool — MIT)",
    "dingminhua (dsh-connect-trae, merged in as dsh-kdczyz-mode/lib/trae.js)"
  ],
  "type": "module",
  "files": [
    "dsh-kdczyz-mode",
    "!dsh-kdczyz-mode/node_modules",
    "README.md",
    "LICENSE"
  ],
  "main": "./dsh-kdczyz-mode/lib/index.js",
  "exports": {
    ".": "./dsh-kdczyz-mode/lib/index.js",
    "./trae": "./dsh-kdczyz-mode/lib/trae.js",
    "./qoder": "./dsh-kdczyz-mode/lib/qoder.js",
    "./client": "./dsh-kdczyz-mode/lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "workbuddy",
    "codebuddy",
    "trae",
    "qoder",
    "model-provider",
    "account-pool",
    "multi-account",
    "credits",
    "usage-history"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-atomic-write": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "scripts": {
    "build:console": "npm --prefix dsh-kdczyz-mode run build:console",
    "check:console": "npm --prefix dsh-kdczyz-mode run check:console",
    "test": "npm --prefix dsh-kdczyz-mode run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-kdczyz-mode/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
