{
  "name": "dsh-kdczyz-mode",
  "version": "1.1.0",
  "private": true,
  "description": "Installable wrapper for the DSH plugin in dsh-kdczyz-mode/: WorkBuddy model pool + Trae connector + Qoder account pool as three independent providers, plus one settings page with six tabs (XD Pool / Trae config [provider switch, account binding, model selection, account pool] / accounts [WorkBuddy + Trae + Qoder, three columns] / Qoder pool [device-flow login, per-account credits, cooldown] / credits / usage history). This root manifest exists so `pnpm add github:kdczyz/dsh-kdczyz-mode` (DSH 插件管理页) installs a package that declares dsh.bundle.patch at its root.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdczyz/dsh-kdczyz-mode.git"
  },
  "homepage": "https://github.com/kdczyz/dsh-kdczyz-mode#readme",
  "license": "MIT",
  "author": "dhdbvcg",
  "contributors": [
    "XDTrees (dsh-workbuddy-xdpool, vendored under dsh-kdczyz-mode/vendor/xdpool — MIT)",
    "dingminhua (dsh-connect-trae, merged in as dsh-kdczyz-mode/lib/trae.js)"
  ],
  "type": "module",
  "main": "./dsh-kdczyz-mode/lib/index.js",
  "exports": {
    ".": "./dsh-kdczyz-mode/lib/index.js",
    "./trae": "./dsh-kdczyz-mode/lib/trae.js",
    "./qoder": "./dsh-kdczyz-mode/lib/qoder.js",
    "./client": "./dsh-kdczyz-mode/lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "workbuddy",
    "codebuddy",
    "trae",
    "qoder",
    "model-provider",
    "account-pool",
    "multi-account",
    "credits",
    "usage-history"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-atomic-write": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "scripts": {
    "build:console": "npm --prefix dsh-kdczyz-mode run build:console",
    "check:console": "npm --prefix dsh-kdczyz-mode run check:console",
    "test": "npm --prefix dsh-kdczyz-mode run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-kdczyz-mode/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
